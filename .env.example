PORT=3000
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_KEYSPACE=
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-4o-mini
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
SSE_HEARTBEAT_MS=15000

# Transcription tuning for the reel analyzer.
# Model: gpt-transcribe (default), gpt-4o-transcribe, gpt-4o-mini-transcribe,
# whisper-1. Only parameters a model documents support are sent to it.
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Set to "off" to stop sending chunking_strategy=auto, which normalizes
# loudness and picks boundaries by voice activity. On by default: a vocal
# under a beat is exactly what it helps with, but it is worth A/B-ing.
# TRANSCRIBE_CHUNKING=auto

# Vocal stem isolation (optional). Unset = transcribe the original mix, the
# behaviour before separation existed. Set it to run clips through Demucs
# first, which is what actually helps a vocal buried under a beat.
# Start the sidecar with: docker compose --profile separation up
# SEPARATOR_URL=http://vocal-separator:8000
# How long to wait for a stem before giving up and transcribing the mix.
# Measured at ~2x real time on 4 CPU cores, so a 60s reel needs ~120s.
# SEPARATOR_TIMEOUT_MS=600000
# DEMUCS_MODEL=htdemucs
# DEMUCS_TIMEOUT_S=600

# Text-based style training has no extra configuration: POST /api/train-style
# uses the same OpenAI and Astra credentials as the rest of the app.
